DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Groq (Llama 3.3 70B, open-weights) — used by investigatorAgent + decisionAgent.
# Required for the RECOVERED golden path: without it, investigatorAgent throws
# and the orchestrator fails safe by escalating the case (no action executed).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

SCHEDULER_POLL_INTERVAL_MS=5000

NODE_ENV=development
